From 6785441aa0302c307a1f16f73900e69dc03df064 Mon Sep 17 00:00:00 2001
From: Gaetan <g.depin@sonoscanner.fr>
Date: Tue, 15 Sep 2026 17:17:17 +0200
Subject: [PATCH] configure.ac: remove fixed paths causing trouble when cross

---
 configure.ac | 1 -
 1 file changed, 1 deletion(-)

diff --git a/configure.ac b/configure.ac
index 6aae1d5b..2797b078 100644
--- a/configure.ac
+++ b/configure.ac
@@ -52,7 +52,6 @@ AC_SUBST(MISCDIR)
 AX_CXX_COMPILE_STDCXX_17([noext], [mandatory])
 
 CPPFLAGS="$CPPFLAGS -Wall -Wextra -Wshadow -g -pedantic-errors"
-CPPFLAGS="$CPPFLAGS -I/usr/include -I/usr/local/include"
 
 AC_CHECK_SIZEOF([void *])
 CXXFLAGS="$CXXFLAGS -DSIZEOF_VOID_P=$ac_cv_sizeof_void_p"
-- 
2.53.0

